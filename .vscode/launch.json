{
  "configurations": [
    {
      "type": "cppdbg",
      "request": "launch",
      "name": "Debug libc-version",
      "program": "${workspaceFolder}/build/libc-version",
      "args": ["${input:arg1}", "${input:arg2}"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build",
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ],
  "inputs": [
    {
      "type": "promptString",
      "id": "arg1",
      "description": "Enter first command line argument"
    },
    {
      "type": "promptString", 
      "id": "arg2",
      "description": "Enter second command line argument"
    }
  ]
}